<section class="section {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}

  <div class="carousel{% if section.settings.card_style == 'overlay' %} carousel--overlay{% endif %}{% if section.blocks.size <= 4 %} carousel--fill{% endif %}" data-carousel style="--slide-width: {{ section.settings.slide_width }}px;">
    <button class="carousel__btn carousel__btn--prev" type="button" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
      {% render 'icon', name: 'arrow-left' %}
    </button>

    <ul class="carousel__track" data-carousel-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title
          assign url = block.settings.link | default: collection.url
          assign image = block.settings.image | default: collection.featured_image
        -%}
        <li class="carousel__slide" {{ block.shopify_attributes }}>
          <a class="edit-card" href="{{ url | default: '#' }}">
            <div class="edit-card__media">
              {%- if image != blank -%}
                <img src="{{ image | image_url: width: 800 }}"
                     srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w"
                     sizes="{% if section.blocks.size <= 4 %}(min-width: 750px) {{ 100 | divided_by: section.blocks.size }}vw, 80vw{% else %}{{ section.settings.slide_width }}px{% endif %}"
                     width="{{ image.width }}" height="{{ image.height }}"
                     alt="{{ title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- assign placeholder_title = 'onboarding.collection_title' | t -%}
            <div class="edit-card__body">
              <p class="edit-card__title">{{ title | default: placeholder_title }}</p>
              {%- if block.settings.text != blank -%}
                <p class="edit-card__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <span class="edit-card__cta">{{ block.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</span>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <button class="carousel__btn carousel__btn--next" type="button" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
      {% render 'icon', name: 'arrow-right' %}
    </button>
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="section-footer">
      <a class="btn {% if section.settings.color_scheme == 'dark' %}btn--light{% endif %}" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small accent-coloured line above the heading." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore edits" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Curated art print walls, hand-picked by our team" },
    { "type": "range", "id": "slide_width", "label": "Card width", "min": 200, "max": 520, "step": 10, "unit": "px", "default": 320 },
    { "type": "select", "id": "card_style", "label": "Card style", "default": "caption", "options": [
      { "value": "caption", "label": "Title below image" },
      { "value": "overlay", "label": "Text over image" }
    ]},
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "subtle", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "blocks": [
    {
      "type": "edit",
      "name": "Edit",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label", "info": "For example \"Mehr erfahren\"." }
      ]
    }
  ],
  "presets": [
    { "name": "Collection carousel", "blocks": [ { "type": "edit" }, { "type": "edit" }, { "type": "edit" }, { "type": "edit" }, { "type": "edit" } ] }
  ]
}
{% endschema %}
