<section class="tile-band">
  {%- if section.settings.heading != blank -%}
    <div class="container section-header" style="padding-top:44px;">
      <h2 class="section-header__title">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="tile-band__grid">
    {%- for block in section.blocks -%}
      {%- assign image = block.settings.image | default: block.settings.collection.featured_image -%}
      <a class="tile" href="{{ block.settings.link | default: block.settings.collection.url | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if image != blank -%}
          <img src="{{ image | image_url: width: 800 }}"
               srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w"
               sizes="(min-width: 900px) 25vw, 50vw"
               width="{{ image.width }}" height="{{ image.height }}"
               alt="{{ block.settings.label | escape }}" loading="lazy">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <span class="tile__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Shop all" } },
        { "type": "tile", "settings": { "label": "Fine art prints" } },
        { "type": "tile", "settings": { "label": "Canvas prints" } },
        { "type": "tile", "settings": { "label": "Wooden frames" } }
      ]
    }
  ]
}
{% endschema %}
