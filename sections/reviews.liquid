<section class="section {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  <div class="container reviews">
    {% render 'stars', count: 5, size: 'lg' %}

    {%- if section.settings.heading != blank -%}
      <h2 class="reviews__headline">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="reviews__grid">
      {%- for block in section.blocks -%}
        <blockquote class="review" {{ block.shopify_attributes }}>
          {% render 'stars', count: block.settings.rating %}
          {%- if block.settings.title != blank -%}
            <p class="review__title">{{ block.settings.title }}</p>
          {%- endif -%}
          <p class="review__body">{{ block.settings.text }}</p>
          {%- if block.settings.author != blank -%}
            <cite class="review__author">{{ block.settings.author }}</cite>
          {%- endif -%}
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "200,000+ homes saved from boring walls" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "subtle", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Only publish reviews you have actually received. Replace the placeholder text before going live." },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Review headline" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Placeholder review text. Replace this with a real customer quote." },
        { "type": "text", "id": "author", "label": "Author", "default": "Customer name" }
      ]
    }
  ],
  "presets": [
    { "name": "Reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
