{%- liquid
  assign products = section.settings.collection.products
  assign limit = section.settings.products_to_show
-%}

<section class="section {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}

  <div class="carousel" data-carousel style="--slide-width: {{ section.settings.slide_width }}px;">
    <button class="carousel__btn carousel__btn--prev" type="button" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
      {% render 'icon', name: 'arrow-left' %}
    </button>

    <ul class="carousel__track" data-carousel-track>
      {%- if products.size > 0 -%}
        {%- for product in products limit: limit -%}
          <li class="carousel__slide">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <li class="carousel__slide">{% render 'product-card' %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    <button class="carousel__btn carousel__btn--next" type="button" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
      {% render 'icon', name: 'arrow-right' %}
    </button>
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="section-footer">
      <a class="btn {% if section.settings.color_scheme == 'dark' %}btn--light{% endif %}"
         href="{{ section.settings.button_link | default: section.settings.collection.url }}">
        {{ section.settings.button_label }}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small accent-coloured line above the heading." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "slide_width", "label": "Card width", "min": 180, "max": 420, "step": 10, "unit": "px", "default": 260 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View more" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the selected collection." },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "presets": [ { "name": "Product carousel" } ]
}
{% endschema %}
