<section class="section {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}

  <div class="container">
    <div class="text-columns{% if section.settings.style == 'quote' %} text-columns--quote{% endif %}">
      {%- for block in section.blocks -%}
        <div class="text-columns__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="text-columns__media">
              <img src="{{ block.settings.image | image_url: width: 800 }}"
                   srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
                   sizes="(min-width: 900px) 30vw, 100vw"
                   width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                   alt="{{ block.settings.image.alt | escape }}" loading="lazy">
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="text-columns__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          <div class="text-columns__text rte">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text columns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "style", "label": "Style", "default": "plain", "options": [
      { "value": "plain", "label": "Plain" },
      { "value": "quote", "label": "Quote cards" }
    ]},
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Column" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Text columns", "blocks": [ { "type": "column" }, { "type": "column" }, { "type": "column" } ] }
  ]
}
{% endschema %}
