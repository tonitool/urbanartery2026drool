<div class="announcement" data-announcement data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="container container--wide announcement__inner">
    <div class="announcement__messages">
      {%- for block in section.blocks -%}
        <div class="announcement__message {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="announcement__message is-active">{{ section.settings.fallback_text }}</div>
      {%- endfor -%}
    </div>

    {%- if section.settings.link_list != blank -%}
      <nav class="announcement__links" aria-label="{{ 'sections.header.announcement' | t }}">
        {%- for link in section.settings.link_list.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "fallback_text", "label": "Fallback message", "default": "Free worldwide shipping on orders over $150" },
    { "type": "range", "id": "interval", "label": "Rotate every", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "link_list", "id": "link_list", "label": "Utility links (right side)", "info": "Shown on desktop only. Keep to two or three short links." }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free worldwide shipping on orders over $150" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [ { "type": "message" } ] }
  ]
}
{% endschema %}
