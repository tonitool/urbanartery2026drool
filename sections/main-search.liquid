<div class="container container--narrow" style="padding-block:40px;">
  <h1 class="page-hero__title" style="text-align:center;">{{ 'general.search.heading' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:8px;margin-top:20px;">
    <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
    <input class="field" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}"
           placeholder="{{ 'general.search.placeholder' | t }}">
    <button class="btn" type="submit">{{ 'general.search.submit' | t }}</button>
  </form>
</div>

{%- if search.performed -%}
  <div class="container">
    {%- if search.results_count > 0 -%}
      <p style="text-align:center;color:var(--color-muted);font-size:0.85rem;">
        {{ 'general.search.results_with_count' | t: count: search.results_count }}
      </p>

      {%- paginate search.results by 24 -%}
        <ul class="product-grid">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a href="{{ item.url }}">
                  <p class="product-card__title">{{ item.title }}</p>
                  <p class="product-card__vendor">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="empty-state">
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{ "name": "Search" }
{% endschema %}
