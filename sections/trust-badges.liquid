<section class="trust">
  <div class="container container--wide">
    <div class="trust__grid">
      {%- for block in section.blocks -%}
        <div class="trust__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <p class="trust__title">{{ block.settings.title }}</p>
          <p class="trust__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Shipping" },
          { "value": "badge", "label": "Quality" },
          { "value": "palette", "label": "Art" }
        ]},
        { "type": "text", "id": "title", "label": "Title", "default": "Ship globally" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Delivered worldwide with a 14-day return period." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Ship globally", "text": "Delivered worldwide with a 14-day return period." } },
        { "type": "badge", "settings": { "icon": "badge", "title": "High quality", "text": "Museum-grade heavyweight paper and handmade frames." } },
        { "type": "badge", "settings": { "icon": "palette", "title": "Unique art", "text": "Curated work from emerging artists, sold only here." } }
      ]
    }
  ]
}
{% endschema %}
