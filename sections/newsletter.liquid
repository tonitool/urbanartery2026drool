<section class="section {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  <div class="container container--narrow newsletter">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-header__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="section-header__subtitle">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.email' | t }}</label>
      <input class="field"
             id="NewsletterEmail-{{ section.id }}"
             type="email"
             name="contact[email]"
             value="{{ form.email }}"
             placeholder="{{ 'general.newsletter.email' | t }}"
             autocomplete="email"
             required>

      {%- assign submit_label = 'general.newsletter.submit' | t -%}
      <button class="btn {% if section.settings.color_scheme == 'dark' %}btn--light{% endif %}" type="submit">
        {{ section.settings.button_label | default: submit_label }}
      </button>

      {%- if form.errors -%}
        <p class="form-status form-status--error">{{ form.errors.messages['email'] }}</p>
      {%- elsif form.posted_successfully? -%}
        <p class="form-status">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.fine_print != blank -%}
      <div class="newsletter__fine rte">{{ section.settings.fine_print }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign up to our newsletter" },
    { "type": "text", "id": "text", "label": "Text", "default": "Early access to new drops and subscriber-only offers." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "richtext", "id": "fine_print", "label": "Fine print", "default": "<p>By signing up you agree to receive marketing emails. Unsubscribe at any time.</p>" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
