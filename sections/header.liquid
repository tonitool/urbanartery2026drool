<header class="header{% if section.settings.color_scheme == 'dark' %} header--dark{% endif %} header--{{ section.settings.layout }}">
  <div class="container container--wide header__inner">

    <button class="header__toggle" type="button" data-drawer-open aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'accessibility.menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" style="max-height: {{ section.settings.logo_height }}px;"
             width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}"
             alt="{{ shop.name | escape }}">
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="{{ 'accessibility.menu' | t }}">
      <ul class="nav__list">
        {%- for link in section.settings.menu.links -%}
          <li class="nav__item">
            <a class="nav__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title }}
              {%- if link.links.size > 0 %}{% render 'icon', name: 'caret' %}{% endif -%}
            </a>

            {%- if link.links.size > 0 -%}
              {%- assign has_grandchildren = false -%}
              {%- for child in link.links -%}
                {%- if child.links.size > 0 -%}{%- assign has_grandchildren = true -%}{%- endif -%}
              {%- endfor -%}

              <div class="nav__dropdown {% if has_grandchildren %}nav__dropdown--mega{% endif %}">
                {%- if has_grandchildren -%}
                  {%- for child in link.links -%}
                    <div>
                      <p class="nav__col-title"><a href="{{ child.url }}">{{ child.title }}</a></p>
                      {%- if child.links.size > 0 -%}
                        <ul class="nav__sublist">
                          {%- for grandchild in child.links -%}
                            <li><a class="nav__sublink" href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <ul class="nav__sublist">
                    {%- for child in link.links -%}
                      <li><a class="nav__sublink" href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- else -%}
          {% render 'header-fallback-links', style: 'nav' %}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      {%- if section.settings.cta_label != blank -%}
        {%- capture configurator_url -%}{% render 'configurator-url' %}{%- endcapture -%}
        <a class="btn btn--small header__cta" href="{{ section.settings.cta_link | default: configurator_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      <a class="header__action" href="{{ routes.search_url }}" aria-label="{{ 'accessibility.search' | t }}">
        {% render 'icon', name: 'search' %}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a class="header__action" href="{{ routes.account_url }}" aria-label="{{ 'accessibility.account' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      {%- if section.settings.wishlist_page != blank -%}
        <a class="header__action" href="{{ section.settings.wishlist_page.url }}" aria-label="{{ 'wishlist.title' | t }}">
          {% render 'icon', name: 'heart' %}
          <span class="cart-count" data-wishlist-count hidden>0</span>
        </a>
      {%- endif -%}

      <a class="header__action" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Mobile drawer {%- endcomment -%}
<div class="drawer" id="MenuDrawer" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}">
  <div class="drawer__head">
    <span class="header__logo">{{ shop.name }}</span>
    <button class="header__action" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  {%- for link in section.settings.menu.links -%}
    {%- if link.links.size > 0 -%}
      <details>
        <summary>{{ link.title }} {% render 'icon', name: 'caret' %}</summary>
        <ul class="drawer__sublist">
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- for child in link.links -%}
            <li><a href="{{ child.url }}">{{ child.title }}</a></li>
            {%- for grandchild in child.links -%}
              <li><a href="{{ grandchild.url }}">&nbsp;&nbsp;{{ grandchild.title }}</a></li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </details>
    {%- else -%}
      <a class="drawer__link" href="{{ link.url }}">{{ link.title }}</a>
    {%- endif -%}
  {%- else -%}
    {% render 'header-fallback-links', style: 'drawer' %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Falls back to the store name as a wordmark." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Two levels of nesting render as a mega menu." },
    { "type": "text", "id": "cta_label", "label": "Header button", "info": "For example \"Jetzt gestalten\". Hidden on small screens." },
    { "type": "url", "id": "cta_link", "label": "Header button link", "info": "Empty: links to the configurator product." },
    { "type": "page", "id": "wishlist_page", "label": "Wishlist page", "info": "A page using the page.wishlist template. Shows a heart in the header." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "stacked", "options": [
      { "value": "stacked", "label": "Logo centred, menu row below" },
      { "value": "inline", "label": "Logo centred, menu left" }
    ]},
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 34 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" },
      { "value": "dark", "label": "Dark" }
    ]}
  ]
}
{% endschema %}
