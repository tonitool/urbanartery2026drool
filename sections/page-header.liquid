<section class="page-header {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  <div class="container container--narrow">
    {%- if section.settings.eyebrow != blank -%}
      <p class="section-header__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="page-header__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="page-header__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Empty: uses the page title." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "presets": [ { "name": "Page header" } ]
}
{% endschema %}
