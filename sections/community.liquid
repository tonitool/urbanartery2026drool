<section class="section {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  <div class="container community">
    {%- if section.settings.eyebrow != blank -%}
      <p class="community__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="community__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="community__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      <a class="header__action" href="{{ section.settings.link }}" aria-label="Instagram" style="margin-inline:auto;">
        {% render 'icon', name: 'instagram' %}
      </a>
    {%- endif -%}
  </div>

  <div class="container container--wide">
    <div class="community__grid">
      {%- for block in section.blocks -%}
        <a class="community__item" href="{{ block.settings.link | default: section.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}"
                 srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 600 }} 600w"
                 sizes="(min-width: 900px) 20vw, 50vw"
                 width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                 alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community love" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our Instagram community" },
    { "type": "text", "id": "text", "label": "Text", "default": "Tag us to see your walls featured here." },
    { "type": "url", "id": "link", "label": "Profile link" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Community gallery", "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ] }
  ]
}
{% endschema %}
