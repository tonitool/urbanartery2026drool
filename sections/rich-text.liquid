{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

<section class="section rich-text {% if section.settings.color_scheme == 'subtle' %}section--subtle{% elsif section.settings.color_scheme == 'dark' %}section--dark{% endif %}">
  <div class="container {% if has_image %}rich-text--with-image{% else %}container--narrow{% endif %} rich-text--{{ section.settings.alignment }}">
    {%- if has_image -%}
      <div class="rich-text__media">
        <img src="{{ section.settings.image | image_url: width: 1200 }}"
             srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
             sizes="(min-width: 900px) 45vw, 100vw"
             width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
             alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy">
      </div>
    {%- endif -%}

    <div class="rich-text__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-header__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- capture configurator_url -%}{% render 'configurator-url' %}{%- endcapture -%}
        <a class="btn {% if section.settings.button_style == 'outline' %}btn--outline{% elsif section.settings.color_scheme == 'dark' %}btn--light{% endif %}"
           href="{{ section.settings.button_link | default: configurator_url }}">
          {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Shown beside the text on desktop." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty: links to the configurator product." },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "solid", "options": [
      { "value": "solid", "label": "Solid" },
      { "value": "outline", "label": "Outline" }
    ]},
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Centre" }
    ]},
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "default", "options": [
      { "value": "default", "label": "Default" },
      { "value": "subtle", "label": "Subtle" },
      { "value": "dark", "label": "Dark" }
    ]}
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
