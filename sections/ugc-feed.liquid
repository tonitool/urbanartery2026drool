{{ 'ugc-feed.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign row_a = ''
  assign row_b = ''
  assign photo_count = 0
  for block in section.blocks
    if block.settings.image == blank
      continue
    endif
    assign photo_count = photo_count | plus: 1
    assign mod = forloop.index0 | modulo: 2
    if mod == 0
      assign row_a = row_a | append: block.id | append: ','
    else
      assign row_b = row_b | append: block.id | append: ','
    endif
  endfor
  assign row_ids = row_a | append: '|' | append: row_b | split: '|'
  assign copies = section.settings.copies
-%}

<section class="ugc-feed" aria-labelledby="UgcFeedHeading-{{ section.id }}"
         style="--ugc-height: {{ section.settings.image_height }}px; --ugc-duration: {{ section.settings.duration }}s; --ugc-copies: {{ copies }};">
  <div class="container ugc-feed__header">
    <div class="ugc-feed__heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ugc-feed__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="ugc-feed__title" id="UgcFeedHeading-{{ section.id }}">
        {{ section.settings.heading }}
        {%- if section.settings.heading_outline != blank -%}
          <span class="ugc-feed__title-outline">{{ section.settings.heading_outline }}</span>
        {%- endif -%}
      </h2>
    </div>
    <div class="ugc-feed__aside">
      <p class="ugc-feed__count"><strong>{{ photo_count }}</strong> {{ section.settings.count_label }}</p>
      {%- if section.settings.invite_label != blank -%}
        <a class="ugc-feed__invite" href="{{ section.settings.invite_link | default: 'mailto:info@urban-artery.de' }}">
          {{ section.settings.invite_label }} {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="ugc-feed__stage">
    {%- for ids in row_ids -%}
      {%- assign id_list = ids | split: ',' -%}
      {%- if id_list.size == 0 -%}{%- continue -%}{%- endif -%}

      {%- if forloop.index == 2 and section.settings.tape_text != blank -%}
        <div class="ugc-tape" aria-hidden="true">
          <div class="ugc-tape__track">
            {%- for i in (1..12) -%}<span>{{ section.settings.tape_text }}</span>{%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="ugc-row{% if forloop.index == 2 %} ugc-row--reverse{% endif %}">
        <ul class="ugc-row__track" role="list">
          {%- for copy in (1..copies) -%}
            {%- for block in section.blocks -%}
              {%- unless id_list contains block.id -%}{%- continue -%}{%- endunless -%}
              {%- liquid
                assign product = block.settings.product
                assign title = block.settings.title | default: product.title
                assign href = product.url | default: block.settings.link
              -%}
              <li class="ugc-tile" {% if copy > 1 %}aria-hidden="true"{% else %}{{ block.shopify_attributes }}{% endif %}>
                <a class="ugc-tile__link" href="{{ href | default: '#' }}" {% if copy > 1 %}tabindex="-1"{% endif %}
                   {% if product != blank %}data-quick-view="{{ product.url }}" aria-haspopup="dialog"{% endif %}>
                  {{ block.settings.image | image_url: width: 640 | image_tag:
                       widths: '320, 480, 640',
                       sizes: '(min-width: 750px) 360px, 220px',
                       loading: 'lazy',
                       alt: block.settings.image.alt | default: title }}
                  <span class="ugc-tile__caption">
                    {%- if title != blank -%}<span class="ugc-tile__title">{{ title }}</span>{%- endif -%}
                    {%- if block.settings.place != blank -%}<span class="ugc-tile__place">{{ block.settings.place }}</span>{%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.note != blank -%}
    <p class="container container--wide ugc-feed__note">{{ section.settings.note }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "UGC feed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inspiration für deine Wand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "So wohnt" },
    { "type": "text", "id": "heading_outline", "label": "Heading, outlined part", "default": "Street-Art" },
    { "type": "text", "id": "count_label", "label": "Counter label", "default": "Wände, ein Gefühl" },
    { "type": "text", "id": "tape_text", "label": "Tape strip text", "default": "Aus deinem Foto wird Street-Art · Handgefertigt · Nur für dich ·" },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 140, "max": 360, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "duration", "label": "Loop duration", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 50 },
    { "type": "range", "id": "copies", "label": "Repeats per row", "min": 2, "max": 6, "step": 1, "default": 4, "info": "Raise this if a row runs out on very wide screens." },
    { "type": "text", "id": "invite_label", "label": "Invite link label", "default": "Dein Foto hier?" },
    { "type": "url", "id": "invite_link", "label": "Invite link", "info": "Empty: email to info@urban-artery.de." },
    { "type": "text", "id": "note", "label": "Small print", "info": "Say here when photos are sample images rather than real customer photos." }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Odd photos run in the top row, even photos in the bottom row." },
        { "type": "product", "id": "product", "label": "Artwork", "info": "Opens the quick view." },
        { "type": "text", "id": "title", "label": "Title", "info": "Empty: the product name." },
        { "type": "text", "id": "place", "label": "Place", "info": "e.g. Loft, Düsseldorf" },
        { "type": "url", "id": "link", "label": "Link", "info": "Used when no product is set." }
      ]
    }
  ],
  "presets": [ { "name": "UGC feed", "blocks": [ { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" } ] } ]
}
{% endschema %}
