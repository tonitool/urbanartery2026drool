{%- liquid
  assign product_form_id = 'ProductForm-' | append: section.id
  assign current = product.selected_or_first_available_variant
  assign on_sale = false
  if current.compare_at_price > current.price
    assign on_sale = true
  endif
-%}

<div class="container product">
  <div class="product__gallery">
    <div class="product__main-image">
      {%- if product.featured_media -%}
        <img id="ProductMainImage"
             src="{{ product.featured_media | image_url: width: 1200 }}"
             srcset="{{ product.featured_media | image_url: width: 600 }} 600w,
                     {{ product.featured_media | image_url: width: 1200 }} 1200w"
             sizes="(min-width: 900px) 55vw, 100vw"
             width="{{ product.featured_media.width }}" height="{{ product.featured_media.height }}"
             alt="{{ product.featured_media.alt | default: product.title | escape }}"
             fetchpriority="high">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="product__thumbs">
        {%- for media in product.media -%}
          <button class="product__thumb" type="button"
                  onclick="document.getElementById('ProductMainImage').src='{{ media | image_url: width: 1200 }}';document.getElementById('ProductMainImage').srcset='';"
                  aria-label="{{ media.alt | escape | default: product.title | escape }}">
            <img src="{{ media | image_url: width: 160 }}" width="160" height="160" alt="{{ media.alt | default: product.title | escape }}" loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__details">
    <div class="product__title-row">
      <h1 class="product__title">{{ product.title }}</h1>
      {% render 'wishlist-button', product: product %}
    </div>
    {%- capture rating_html -%}{% render 'rating', product: product, size: 'md' %}{%- endcapture -%}
    {%- if rating_html != blank -%}
      <a class="product__rating" href="#{{ section.settings.reviews_anchor | default: 'reviews' }}">{{ rating_html }}</a>
    {%- endif -%}

    {%- if product.vendor != blank -%}
      <p class="product__vendor">{{ 'products.product.vendor' | t: vendor: product.vendor }}</p>
    {%- endif -%}

    <p class="product__price" data-product-price>
      <span {% if on_sale %}class="on-sale"{% endif %}>{{ current.price | money }}</span>
      {%- if on_sale %}<s>{{ current.compare_at_price | money }}</s>{% endif -%}
    </p>

    {%- if section.settings.show_tax_note -%}
      <p class="product__tax-note">
        {%- if shop.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- else -%}{{ 'products.product.taxes_excluded' | t }}{%- endif -%}
        {%- if shop.shipping_policy.body != blank -%}
          , <a class="link-underline" href="{{ shop.shipping_policy.url }}">{{ 'products.product.shipping_excluded' | t }}</a>
        {%- else -%}
          , {{ 'products.product.shipping_excluded' | t }}
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- form 'product', product, id: product_form_id, class: 'product-form', data-product-form: 'true' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="option" data-option-index="{{ forloop.index0 }}">
            <span class="option__label">{{ option.name }}</span>
            <div class="option__values">
              {%- for value in option.values -%}
                <label class="option__value">
                  <input type="radio"
                         name="option-{{ section.id }}-{{ option.position }}"
                         value="{{ value | escape }}"
                         {% if option.selected_value == value %}checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <div class="option">
        <label class="option__label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
        <input class="field" style="max-width:110px;" id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
      </div>

      <button class="btn btn--full" type="submit" name="add"
              data-add-to-cart
              data-add="{{ 'products.product.add_to_cart' | t | escape }}"
              data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
              data-unavailable="{{ 'products.product.unavailable' | t | escape }}"
              {% unless current.available %}disabled{% endunless %}>
        {%- if current.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
      </button>

      {{ form | payment_button }}

      {%- if section.settings.delivery_note != blank -%}
        <p class="product__delivery">{% render 'icon', name: 'clock' %}<span>{{ section.settings.delivery_note }}</span></p>
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="product__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <script type="application/json" data-variants>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "available": {{ variant.available | json }},
              "options": {{ variant.options | json }},
              "price_html": {{ variant.price | money | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    {%- endform -%}

    {%- comment -%} App blocks (e.g. a product configurator) sit directly under the buy button. {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
    {%- endfor -%}

    {%- assign trust_blocks = section.blocks | where: 'type', 'trust_item' -%}
    {%- if trust_blocks.size > 0 -%}
      <ul class="product-trust" role="list">
        {%- for block in trust_blocks -%}
          <li class="product-trust__item" {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icon %}
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign description_blocks = section.blocks | where: 'type', 'description' -%}
    {%- if description_blocks.size == 0 and product.description != blank -%}
      <div class="product__description rte">{{ product.description }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            {%- if block.settings.title != blank -%}
              <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title }} {% render 'icon', name: 'caret' %}</summary>
                <div class="accordion__body rte">{{ product.description }}</div>
              </details>
            {%- else -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}
          {%- endif -%}

        {%- when 'text' -%}
          <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'accordion' -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.title }} {% render 'icon', name: 'caret' %}</summary>
            <div class="accordion__body rte">{{ block.settings.content }}</div>
          </details>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.sticky_buy_bar -%}
  <div class="sticky-buy" data-sticky-buy hidden>
    <div class="sticky-buy__info">
      <p class="sticky-buy__title">{{ product.title }}</p>
      <p class="sticky-buy__price" data-product-price>{{ current.price | money }}</p>
    </div>
    <button class="btn" type="submit" name="add" form="{{ product_form_id }}" {% unless current.available %}disabled{% endunless %}>
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
{%- endif -%}

{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    {%- if product.vendor != blank %}"brand": { "@type": "Brand", "name": {{ product.vendor | json }} },{% endif %}
    {%- if rating != blank and rating_count > 0 -%}
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rating.rating | json }}, "bestRating": {{ rating.scale_max | json }}, "reviewCount": {{ rating_count | json }} },
    {%- endif %}
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
      "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
      "offerCount": {{ product.variants.size }},
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
    }
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_tax_note", "label": "Show tax and shipping note under price", "default": true, "info": "Required for consumer sales in Germany (PAngV)." },
    { "type": "text", "id": "delivery_note", "label": "Delivery promise under the buy button", "default": "Handmade and shipped within 10–14 working days" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons under the buy button", "default": true },
    { "type": "checkbox", "id": "sticky_buy_bar", "label": "Sticky buy bar on mobile", "default": true },
    { "type": "text", "id": "reviews_anchor", "label": "Reviews anchor id", "default": "reviews", "info": "The rating under the title links to this id; set it to your reviews app block's id." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "trust_item",
      "name": "Trust icon",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "hand", "options": [
          { "value": "hand", "label": "Handmade" },
          { "value": "spray", "label": "Spray can" },
          { "value": "badge", "label": "Quality" },
          { "value": "palette", "label": "Art" },
          { "value": "truck", "label": "Shipping" },
          { "value": "frame", "label": "Frame" },
          { "value": "gift", "label": "Gift" },
          { "value": "shield", "label": "Secure payment" }
        ]},
        { "type": "text", "id": "text", "label": "Text", "default": "Handmade" }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Accordion title", "info": "Leave empty to show the description as plain text." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short note shown on every product.</p>" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your shipping and returns information here.</p>" }
      ]
    }
  ]
}
{% endschema %}
