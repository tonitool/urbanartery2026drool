{% render 'contact-page', s: section.settings, blocks: section.blocks, section_id: section.id %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kontakt" },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "info_heading", "label": "Heading", "default": "Unsere Kontaktmöglichkeiten" },
    { "type": "text", "id": "note", "label": "Note" },
    { "type": "text", "id": "cta_heading", "label": "Teaser heading", "default": "Großes Projekt?" },
    { "type": "text", "id": "cta_text", "label": "Teaser text" },
    { "type": "url", "id": "cta_link", "label": "Teaser link", "info": "Empty: /pages/auftragsarbeiten" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Kontaktformular" },
    { "type": "text", "id": "topics_label", "label": "Topic question", "default": "Worum geht's?" },
    { "type": "text", "id": "topics", "label": "Topics", "info": "Comma-separated.", "default": "Eigenes Motiv, Bestellung, Auftragsarbeit, Kooperation, Sonstiges" },
    { "type": "text", "id": "label_first", "label": "First name", "default": "Vorname" },
    { "type": "text", "id": "label_last", "label": "Last name", "default": "Nachname" },
    { "type": "text", "id": "label_email", "label": "Email", "default": "E-Mail-Adresse" },
    { "type": "text", "id": "label_order", "label": "Order number", "default": "Bestellnummer (optional)" },
    { "type": "text", "id": "label_subject", "label": "Subject", "default": "Betreff" },
    { "type": "text", "id": "label_message", "label": "Message", "default": "Deine Nachricht" },
    { "type": "text", "id": "label_send", "label": "Button", "default": "Absenden" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Danke! Wir melden uns in Kürze bei dir." },
    { "type": "richtext", "id": "privacy_note", "label": "Privacy note" }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Contact channel",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "mail", "options": [
          { "value": "phone", "label": "Phone" },
          { "value": "mail", "label": "Email" },
          { "value": "instagram", "label": "Instagram" },
          { "value": "clock", "label": "Clock" }
        ]},
        { "type": "text", "id": "title", "label": "Title", "default": "E-Mail" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
