{%- comment -%}
  Responsive <img> for an image setting, or a Shopify placeholder when empty.
  Usage: {% render 'responsive-image', image: img, widths: '600,1200,2000', sizes: '100vw', alt: 'Text', class: 'x', lazy: true, placeholder: 'lifestyle-1' %}
{%- endcomment -%}
{%- if image != blank -%}
  {%- liquid
    assign width_list = widths | default: '600,1200,1800' | split: ','
    assign largest = width_list | last | plus: 0
  -%}
  <img class="{{ class }}"
       src="{{ image | image_url: width: largest }}"
       srcset="{%- for w in width_list -%}{{ image | image_url: width: w }} {{ w | strip }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
       sizes="{{ sizes | default: '100vw' }}"
       width="{{ image.width }}" height="{{ image.height }}"
       alt="{{ alt | default: image.alt | escape }}"
       {% if lazy != false %}loading="lazy"{% endif %} draggable="false">
{%- else -%}
  {{ placeholder | default: 'lifestyle-1' | placeholder_svg_tag: class }}
{%- endif -%}
