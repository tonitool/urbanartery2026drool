{%- comment -%}
  Star rating from Shopify's standard review metafields (reviews.rating, reviews.rating_count),
  which review apps such as Judge.me, Okendo or Shopify Product Reviews fill in.
  Renders nothing when a product has no reviews — never shows invented ratings.
  Usage: {% render 'rating', product: product, size: 'sm' %}
{%- endcomment -%}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if rating != blank and rating_count > 0 -%}
  {%- liquid
    assign rating_value = rating.rating | round: 1
    assign scale_max = rating.scale_max | default: 5
    assign filled = rating.rating | round
    assign label = 'products.product.rating_label' | t: rating: rating_value, max: scale_max, count: rating_count
  -%}
  <span class="rating rating--{{ size | default: 'sm' }}" role="img" aria-label="{{ label | escape }}">
    <span class="rating__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <span class="rating__star{% if i > filled %} rating__star--empty{% endif %}">{% render 'icon', name: 'star' %}</span>
      {%- endfor -%}
    </span>
    <span class="rating__text" aria-hidden="true">{{ rating_value }} ({{ rating_count }})</span>
  </span>
{%- endif -%}
