[
  {
    "name": "theme_info",
    "theme_name": "Urban Artery",
    "theme_version": "1.0.0",
    "theme_author": "tonitool",
    "theme_documentation_url": "https://github.com/tonitool/urbanartery2026drool",
    "theme_support_url": "https://github.com/tonitool/urbanartery2026drool/issues"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Page" },
      { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
      { "type": "color", "id": "color_fg", "label": "Text", "default": "#000000" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#5c5c5c" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#e2e2e2" },
      { "type": "color", "id": "color_subtle", "label": "Subtle band background", "default": "#f1f1f1" },
      { "type": "header", "content": "Dark sections" },
      { "type": "color", "id": "color_dark", "label": "Dark background", "default": "#000000" },
      { "type": "color", "id": "color_dark_fg", "label": "Dark section text", "default": "#ffffff" },
      { "type": "header", "content": "Accent" },
      { "type": "color", "id": "color_accent", "label": "Accent (announcement bar, eyebrows, heading bar)", "info": "Keep white text readable: #e60073 is the lightest Urban Artery pink with 4.5:1 contrast.", "default": "#e60073" },
      { "type": "color", "id": "color_accent_fg", "label": "Accent text", "default": "#ffffff" },
      { "type": "header", "content": "Buttons" },
      { "type": "color", "id": "color_btn_bg", "label": "Button background", "default": "#e60073" },
      { "type": "color", "id": "color_btn_fg", "label": "Button text", "default": "#ffffff" },
      { "type": "header", "content": "Sale" },
      { "type": "color", "id": "color_sale", "label": "Sale price", "default": "#e60073" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "checkbox", "id": "use_brand_fonts", "label": "Use bundled brand fonts", "default": true, "info": "Allerta Stencil (headings) and Inconsolata (body), served from the theme's own assets. Untick to use the font pickers below." },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "inconsolata_n4" },
      { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "archivo_n7" },
      { "type": "range", "id": "font_size_base", "label": "Base font size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 15 },
      { "type": "range", "id": "heading_scale", "label": "Heading scale", "min": 90, "max": 130, "step": 5, "unit": "%", "default": 100 },
      { "type": "checkbox", "id": "uppercase_headings", "label": "Uppercase section titles", "default": true },
      { "type": "checkbox", "id": "heading_bar", "label": "Accent bar under section titles", "default": true }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Page width", "min": 1100, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
      { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
      { "type": "select", "id": "button_style", "label": "Button shape", "default": "square", "options": [
        { "value": "square", "label": "Square" },
        { "value": "soft", "label": "Slightly rounded" },
        { "value": "pill", "label": "Pill" }
      ]}
    ]
  },
  {
    "name": "Konfigurator",
    "settings": [
      { "type": "product", "id": "configurator_product", "label": "Configurator product", "info": "The product that carries the configurator app. Buttons marked \"Link to configurator\" and empty primary buttons point here." }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "select", "id": "card_image_ratio", "label": "Image ratio", "default": "portrait", "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "tall", "label": "Tall (2:3)" }
      ]},
      { "type": "checkbox", "id": "card_show_vendor", "label": "Show artist (vendor)", "default": true },
      { "type": "checkbox", "id": "card_price_from", "label": "Show price range when variants differ", "default": true },
      { "type": "checkbox", "id": "card_hover_image", "label": "Swap to second image on hover", "default": true },
      { "type": "checkbox", "id": "card_quick_add", "label": "Quick add to cart on single-variant products", "default": true }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "range", "id": "free_shipping_threshold", "label": "Free-shipping threshold", "min": 0, "max": 500, "step": 10, "unit": "€", "default": 150, "info": "Shows a progress bar in the cart. 0 hides it. Keep it in sync with your shipping rates." }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
    ]
  },
  {
    "name": "Social sharing image",
    "settings": [
      { "type": "image_picker", "id": "share_image", "label": "Default sharing image" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon (32 x 32px)" }
    ]
  }
]
